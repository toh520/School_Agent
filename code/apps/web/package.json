{
  "name": "@school-agent/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "axios": "1.20.0",
    "element-plus": "2.11.5",
    "pinia": "3.0.3",
    "vue": "3.5.22",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.7.2",
    "@vitejs/plugin-vue": "6.0.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue-tsc": "3.1.1"
  }
}
