# Copy this file to code/deploy/.env.local and replace every replace_with_* placeholder.
# code/deploy/.env.local is ignored by Git and must never be committed.
SCHOOL_AGENT_DB_HOST=127.0.0.1
SCHOOL_AGENT_DB_PORT=5432
SCHOOL_AGENT_DB_NAME=school_agent
SCHOOL_AGENT_DB_USERNAME=school_agent
SCHOOL_AGENT_DB_PASSWORD=replace_with_local_password
SCHOOL_AGENT_DB_URL=jdbc:postgresql://127.0.0.1:5432/school_agent

SCHOOL_AGENT_CORE_PORT=8080
SCHOOL_AGENT_AGENT_PORT=8000
SCHOOL_AGENT_CORE_URL=http://127.0.0.1:8080
SCHOOL_AGENT_AGENT_URL=http://127.0.0.1:8000
SCHOOL_AGENT_WEB_ORIGIN=http://127.0.0.1:5173

# Generate a private value of at least 32 characters for each environment.
SCHOOL_AGENT_AUTH_JWT_SECRET=replace_with_32_character_minimum_secret
SCHOOL_AGENT_AUTH_ACCESS_MINUTES=15
SCHOOL_AGENT_AUTH_REFRESH_DAYS=7

# M04 model adapter. Keep the real API key only in code/deploy/.env.local.
SCHOOL_AGENT_LLM_PROVIDER=siliconflow
SCHOOL_AGENT_LLM_BASE_URL=https://api.siliconflow.cn/v1
SCHOOL_AGENT_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
SCHOOL_AGENT_LLM_API_KEY=replace_with_local_model_api_key
SCHOOL_AGENT_LLM_TIMEOUT_SECONDS=180
SCHOOL_AGENT_LLM_MAX_RETRIES=2
